{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lorne-orbit",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "lorne-orbit-images"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lorne-orbit",
      "database_id": "cf58d4c1-4c92-4553-988d-d5b611fd25a1",
      "migrations_dir": "worker/migrations"
    }
  ],
  "vars": {
    "ADMIN_USERNAME": "Lorne"
  }
}
